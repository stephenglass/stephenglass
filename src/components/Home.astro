---
/**
 * The whole site: the name, fitted to its measure, and three links with Tony
 * perched on their top rule, where a laser dot now and then visits. Tonelabs
 * is the one dark row.
 *
 * Two layouts, switched by `LayoutSwitch` through `html[data-layout]`:
 * compact (the default) sets everything together in a centred column; full
 * spreads the name and links across the screen, top and bottom.
 */
import LaserDot from "@/components/LaserDot.astro";
import LayoutSwitch from "@/components/LayoutSwitch.astro";
import PetTony from "@/components/PetTony.astro";
import TonelabsDither from "@/components/TonelabsDither.astro";
import { site } from "@/data/site";

const links = [
  { label: "GitHub", href: site.githubUrl, detail: "@stephenglass" },
  { label: "Email", href: `mailto:${site.email}`, detail: site.email },
];
---

<div class="page gutter min-h-svh">
  <div class="column">
    <h1 class="name">{site.name}</h1>

    <nav aria-label="Links" class="links relative">
      <LaserDot />
      <PetTony class="links__tony" />
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} class="row group border-ink/10 border-t">
              <span class="row__label">{link.label}</span>
              <span class="row__detail text-ink-dim">
                <span class="max-sm:sr-only">{link.detail}</span>
                <svg class="row__arrow" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M4.5 11.5l7-7M5.5 4.5h6v6" />
                </svg>
              </span>
            </a>
          </li>
        ))}
        <li>
          <a
            href={site.tonelabsUrl}
            class="row row--tonelabs group bg-obsidian text-bone relative isolate overflow-hidden"
          >
            <TonelabsDither class="absolute inset-0 -z-10" />
            <span class="row__label">Tonelabs</span>
            <span class="row__detail text-bone-dim">
              <span class="max-sm:sr-only">tonelabs.io</span>
              <svg class="row__arrow" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M4.5 11.5l7-7M5.5 4.5h6v6" />
              </svg>
            </span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <LayoutSwitch />
</div>

<style>
  /*
   * The name fills its measure, ink edge to ink edge, on one line: `--k` is
   * its ink width in em, measured with the real font.
   */
  .page {
    --measure: 56rem;
    --tony-cell: 2px;
  }

  @media (width >= 48rem) {
    .page {
      --tony-cell: 3px;
    }
  }

  .column {
    container-type: inline-size;
  }

  .name {
    --k: 6.3;
    font-size: calc(min(100cqw, var(--measure)) / var(--k));
    line-height: 0.86;
    /* Pull the S's side bearing out so its ink sits on the gutter. */
    margin-left: -0.027em;
  }

  /* Compact (default): name and links together, centred on the screen. */
  .page {
    display: grid;
    place-items: center;
  }

  .column {
    width: 100%;
    max-width: var(--measure);
    padding-block: 4rem;
  }

  .links {
    margin-top: clamp(6rem, 13svh, 8.5rem);
  }

  /* Full: the name at the top, the links at the bottom of the screen. */
  :global(html[data-layout="full"]) .page {
    display: block;
  }

  :global(html[data-layout="full"]) .column {
    display: grid;
    grid-template-rows: 1fr auto;
    grid-template-columns: minmax(0, 1fr);
    max-width: none;
    min-height: 100svh;
    padding-top: clamp(4.5rem, 14svh, 8rem);
    padding-bottom: clamp(1rem, 4svh, 2.5rem);
  }

  :global(html[data-layout="full"]) .links {
    margin-top: 8rem;
  }

  /*
   * Tony sits on the links' top rule, at the right, out of the way. He
   * scales by whole pixels so his cells stay crisp.
   */
  .links :global(.links__tony) {
    position: absolute;
    right: 0.75rem;
    bottom: 100%;
    width: calc(28 * var(--tony-cell));
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(0.85rem, 2.2svh, 1.35rem);
  }

  .row__label {
    font-size: clamp(1.625rem, 1.1rem + 1.8vw, 2.5rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-decoration: underline 2px transparent;
    text-underline-offset: 0.16em;
    transition: text-decoration-color 300ms var(--ease-out-soft);
  }

  .row:hover .row__label,
  .row:focus-visible .row__label {
    text-decoration-color: currentColor;
  }

  .row__detail {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
    transition: color 300ms var(--ease-out-soft);
  }

  .row:hover .row__detail,
  .row:focus-visible .row__detail {
    color: inherit;
  }

  .row__arrow {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: square;
  }

  /* The dark window bleeds past the column so its label still lines up. */
  .row--tonelabs {
    margin-inline: -1rem;
    padding-inline: 1rem;
  }

  @media (width >= 48rem) {
    .row--tonelabs {
      margin-inline: -1.25rem;
      padding-inline: 1.25rem;
    }
  }
</style>
