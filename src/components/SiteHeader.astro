---
import PixelGlyph from "@/components/PixelGlyph.astro";
import { site } from "@/data/site";
import type { GlyphName } from "@/lib/glyphs";

const links: readonly { label: string; href: string; glyph: GlyphName }[] = [
  { label: "GitHub", href: site.githubUrl, glyph: "github" },
  { label: "LinkedIn", href: site.linkedinUrl, glyph: "linkedin" },
  { label: "Email", href: `mailto:${site.email}`, glyph: "mail" },
];
---

<header class="text-bone absolute inset-x-0 top-0 z-10">
  <div class="wrap flex items-center justify-end py-6 md:py-8">
    <nav aria-label="Primary">
      <ul class="flex items-center gap-6 md:gap-8">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="group text-bone-dim hover:text-bone focus-visible:text-bone ease-out-soft -my-2 flex items-center gap-2 py-2 text-base font-semibold tracking-[-0.01em] transition-colors duration-300"
            >
              <PixelGlyph
                name={link.glyph}
                class="ease-out-soft size-4 opacity-60 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
              />
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
