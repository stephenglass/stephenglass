---
/**
 * Tony's game (src/scripts/game): the aquarium in a hairline frame on paper.
 * Before the script mounts (or without JS) the tank shows Tony asleep.
 */
import PixelSprite from "@/components/PixelSprite.astro";
import { TONY_SLEEP, ZZ } from "@/lib/sprites";
---

<section
  id="fish-catch"
  class="py-24 md:py-32"
  aria-labelledby="fish-catch-title"
  data-game
>
  <div class="wrap">
    <div class="grid items-center gap-y-12 md:grid-cols-12 md:gap-x-10">
      <div class="md:col-span-5">
        <p class="text-ink-dim text-base font-semibold">Inspired by Tonelabs</p>
        <h2
          id="fish-catch-title"
          class="mt-4 text-[clamp(2.25rem,3.8vw,3.5rem)]"
        >
          Fish Catch.
        </h2>
        <p class="text-ink-dim mt-6 flex items-center gap-3 text-base">
          <span class="bg-aqua inline-block size-2 rounded-full"></span>
          Catch fish. Dodge starfish.
        </p>

        <dl
          class="mt-10 grid max-w-xs grid-cols-3 border-t border-ink/10 pt-6 text-base tabular-nums"
          aria-hidden="true"
        >
          <div>
            <dt class="text-ink-dim">Lives</dt>
            <dd
              data-game-lives
              data-lost=""
              class="game-lives text-aqua-ink mt-1 font-semibold tracking-[0.12em]"
            >
              ♥♥♥
            </dd>
          </div>
          <div>
            <dt class="text-ink-dim">Fish</dt>
            <dd data-game-score class="mt-1 font-semibold">
              000
            </dd>
          </div>
          <div>
            <dt class="text-ink-dim">Best</dt>
            <dd data-game-best class="mt-1 font-semibold">
              000
            </dd>
          </div>
        </dl>
      </div>

      <div class="md:col-span-7">
        <div
          class="game relative select-none"
          data-game-tile
          data-phase="idle"
          tabindex="0"
          role="group"
          aria-roledescription="game"
          aria-label="Fish Catch"
          aria-describedby="game-help"
        >
          <div data-game-frame class="game-frame relative aspect-[16/10]">
            <div class="absolute inset-0 flex items-end justify-center">
              <canvas data-game-canvas class="pixelated block"></canvas>
              <div
                class="game-poster flex items-end gap-1 pb-6"
                aria-hidden="true"
              >
                <PixelSprite pixels={TONY_SLEEP} class="h-auto w-20" />
                <PixelSprite pixels={ZZ} class="text-ink mb-16 size-4" />
              </div>
            </div>
            <div
              data-game-floats
              aria-hidden="true"
              class="pointer-events-none absolute inset-0"
            ></div>
          </div>
        </div>
        <p
          data-game-message
          aria-hidden="true"
          class="text-ink-dim mt-4 min-h-6 text-base"
        ></p>
        <p id="game-help" class="sr-only">
          A small game. Press Space to start, then use the left and right arrow
          keys to move Tony. Catch sinking fish; golden fish are worth five.
          Avoid starfish: three and it is game over. Press P to pause.
        </p>
        <p data-game-status role="status" class="sr-only"></p>
        <noscript>
          <p class="text-ink-dim mt-4 text-base">
            Fish Catch needs JavaScript. Tony is napping.
          </p>
        </noscript>
      </div>
    </div>
  </div>
</section>

<style>
  .game {
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
  }

  /* No frame: the tank's edges soften just slightly into the paper. */
  .game-frame {
    mask-image:
      linear-gradient(
        to right,
        transparent 0,
        black 3%,
        black 97%,
        transparent 100%
      ),
      linear-gradient(
        to bottom,
        transparent 0,
        black 7%,
        black 97%,
        transparent 100%
      );
    mask-composite: intersect;
  }

  /* Only while playing, so swipes still scroll the page otherwise. */
  .game:global(.is-playing) {
    touch-action: none;
  }

  .game:not([data-ready]) canvas,
  .game[data-ready] .game-poster {
    display: none;
  }

  .game-lives::after {
    content: attr(data-lost);
    opacity: 0.3;
  }

  .game :global(.game-float) {
    position: absolute;
    font-size: 1rem;
    font-weight: 650;
    line-height: 1;
    color: #fff;
    text-shadow: 0 1px 0 rgb(13 59 82 / 0.6);
    pointer-events: none;
    animation: emoji-pop 0.9s var(--ease-out-soft) forwards;
  }

  .game :global(.game-float[data-still]) {
    animation: emoji-fade 0.9s linear forwards;
  }
</style>

<script>
  import "@/scripts/game";
</script>
