---
/**
 * Tony, sitting. Click to pet him (see src/scripts/pet.ts). Without JS he is
 * a still picture inside a button that does nothing, which is harmless. He
 * fills the width the caller gives him.
 */
import PixelSprite from "@/components/PixelSprite.astro";
import { TONY_LIT_BLINK, TONY_LIT_SIT } from "@/lib/sprites";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const frames = [
  { name: "sit", pixels: TONY_LIT_SIT },
  { name: "blink", pixels: TONY_LIT_BLINK },
  { name: "happy", pixels: TONY_LIT_BLINK },
];
---

<div data-pet-root class:list={["pet relative", className]}>
  <span
    data-pet-bubble
    hidden
    aria-hidden="true"
    class="bg-ink text-paper after:border-t-ink absolute right-1/2 bottom-full z-10 mb-3 px-3 py-1.5 text-sm font-semibold whitespace-nowrap select-none after:absolute after:top-full after:right-2 after:border-x-[5px] after:border-t-[6px] after:border-x-transparent"
  >
    meow.
  </span>

  <button
    type="button"
    data-pet
    aria-label="Pet Tony"
    class="pet__button relative block w-full touch-manipulation select-none"
  >
    <span data-pet-sprite class="pet__sprite block origin-bottom">
      {frames.map((frame) => (
        <PixelSprite
          pixels={frame.pixels}
          data-frame={frame.name}
          data-active={frame.name === "sit" ? "" : undefined}
          class="block h-auto w-full"
        />
      ))}
    </span>
    <span
      data-pet-layer
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 z-20"
    ></span>
  </button>

  <span
    aria-hidden="true"
    class="pet__purr text-ink-dim absolute bottom-full left-[34%] mb-2 -translate-x-1/2 text-sm font-semibold select-none"
  >
    prrr
  </span>
  <span
    data-pet-count
    hidden
    aria-hidden="true"
    class="border-ink/10 bg-paper text-ink-dim absolute right-full bottom-0 mr-2 border px-1.5 py-1 text-xs leading-none font-semibold tabular-nums select-none"
  ></span>
</div>

<style>
  .pet__button {
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    cursor: pointer;
  }

  /* A comfortable tap target, even when he is small. */
  .pet__button::before {
    content: "";
    position: absolute;
    inset: -0.75rem;
  }

  .pet__sprite :global([data-frame]:not([data-active])) {
    display: none;
  }

  .pet__purr {
    opacity: 0;
    transition: opacity 300ms var(--ease-out-soft);
  }

  .is-purring .pet__purr {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .is-purring .pet__sprite :global(svg) {
      animation: purr 120ms linear infinite;
    }
  }

  .pet :global(.pet-float) {
    position: absolute;
    top: 0;
    left: 50%;
    font-size: 1.375rem;
    line-height: 1;
    pointer-events: none;
    animation: emoji-pop 1.2s var(--ease-out-soft) forwards;
  }

  .pet :global(.pet-float[data-still]) {
    animation: emoji-fade 1.2s linear forwards;
  }
</style>

<script>
  import "@/scripts/pet";
</script>
