---
/**
 * A 1-bit glyph from src/lib/glyphs.ts in `currentColor`, after tonelabs'
 * PixelGlyph. Size it at a whole multiple of its grid (16 or 8 cells).
 */
import { GLYPHS, type GlyphName } from "@/lib/glyphs";
import { sizeOf, toRuns } from "@/lib/pixels";

interface Props {
  name: GlyphName;
  class?: string;
  [attribute: `data-${string}`]: string | undefined;
}

const { name, class: className, ...rest } = Astro.props;
const pixels = GLYPHS[name];
const { width, height } = sizeOf(pixels);
---

<svg
  class={className}
  viewBox={`0 0 ${width} ${height}`}
  fill="currentColor"
  shape-rendering="crispEdges"
  aria-hidden="true"
  {...rest}
>
  {toRuns(pixels).map((run) => (
    <rect x={run.x} y={run.y} width={run.width} height="1" />
  ))}
</svg>
